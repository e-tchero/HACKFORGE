# HACKFORGE configuration.
# Copy to .env and fill in. Never commit real credentials.

# --- autonomy -------------------------------------------------------------
# 0 OBSERVE | 1 PREPARE | 2 BUILD | 3 AUTONOMOUS
# Level 1+ is required before HACKFORGE creates any workspace directory.
HACKFORGE_AUTONOMY_LEVEL=0

# --- storage ---------------------------------------------------------------
HACKFORGE_DATA_DIR=
# Defaults to %USERPROFILE%\.hackforge
HACKFORGE_WORKSPACE_ROOT=
# Defaults to %USERPROFILE%\Hackathons

# Empty = JSON store. Use sqlite:path for the SQLite store.
# A postgresql:// URL is recognised but not implemented yet.
HACKFORGE_DATABASE_URL=
HACKFORGE_TIMEZONE=UTC

# Optional JSON file for tuning research and urgency thresholds.
# {"research": {"max_pages_per_opportunity": 25},
#  "deadlines": {"long_range_days": 30, "planning_days": 14,
#                "active_days": 7, "critical_hours": 72,
#                "final_window_hours": 24}}
HACKFORGE_CONFIG_FILE=

# --- gmail (read-only) -----------------------------------------------------
# OAuth desktop client JSON from Google Cloud Console -> Credentials.
GMAIL_CREDENTIALS_PATH=
# Where the cached OAuth token is written.
GMAIL_TOKEN_PATH=
GMAIL_QUERY=newer_than:90d
GMAIL_MAX_MESSAGES=200